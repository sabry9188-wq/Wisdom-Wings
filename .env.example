# Supabase project settings — Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-side only, NEVER expose to the browser or
# prefix with NEXT_PUBLIC_. Used by /api/admin routes and scripts/create-admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMS provider selection. "console" (default) just logs messages to the
# server console — no real SMS is sent. Add a real provider's env vars here
# once one is connected (see src/lib/sms).
SMS_PROVIDER=console
